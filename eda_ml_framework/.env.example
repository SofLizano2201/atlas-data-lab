# Plantilla de configuración; exportar variables en la terminal, no se carga automáticamente.
# Nunca incluir claves reales en este archivo ni en Git.
ATLAS_LLM_PROVIDER=
ATLAS_LLM_MODEL=
ATLAS_LLM_BASE_URL=
ATLAS_LLM_API_KEY=
# Optional local installation, no key required:
# ATLAS_LLM_PROVIDER=ollama
# ATLAS_LLM_MODEL=your-installed-local-model
# ATLAS_LLM_BASE_URL=http://127.0.0.1:11434/v1
